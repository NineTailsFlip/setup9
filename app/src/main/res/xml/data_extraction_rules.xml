<?xml version="1.0" encoding="utf-8"?>
<!-- Setup keeps nothing worth moving to another phone: where it was, and the look it hands to the
     Nine apps, which keep their own copy (and their own Settings -> Backup). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
